<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#1B2D72">
<title>Sumczykowe Mikołaje</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
<style>
  :root {
    --sky-top: #1B2D72;
    --sky-mid: #2A479C;
    --sky-low: #3558AE;
    --paper: #FFFCF4;
    --ink: #1B2440;
    --muted: #5C6785;
    --line: #E4EAF6;
    --red: #D62F45;
    --red-dark: #B8243A;
    --gold: #F7BE3E;
    --gold-soft: #FFF3CF;
    --pine: #2E8559;
    --pine-dark: #25704A;
    --snow: #F4F8FF;
    --display: "Fraunces", Georgia, "Times New Roman", serif;
    --body: "Figtree", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; background: var(--sky-low); }
  body {
    margin: 0; color: var(--ink); font: 400 1rem/1.45 var(--body);
    min-height: 100vh; position: relative; overflow-x: hidden;
    background: linear-gradient(180deg, var(--sky-top) 0, var(--sky-mid) 520px, var(--sky-low) 100%);
  }
  .garland {
    position: absolute; top: 0; left: 0; right: 0; height: 44px; z-index: 2; pointer-events: none;
    background: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22240%22 height=%2244%22 viewBox=%220 0 240 44%22%3E%3Cpath d=%22M0 5 Q30 27 60 5 Q90 27 120 5 Q150 27 180 5 Q210 27 240 5%22 stroke=%22%230C1745%22 stroke-width=%221.8%22 fill=%22none%22/%3E%3Ccircle cx=%2230%22 cy=%2226%22 r=%2211%22 fill=%22%23FF4D63%22 opacity=%22.28%22/%3E%3Crect x=%2227.4%22 y=%2215%22 width=%225.2%22 height=%225%22 rx=%221%22 fill=%22%230C1745%22/%3E%3Cellipse cx=%2230%22 cy=%2226%22 rx=%224.6%22 ry=%226.4%22 fill=%22%23FF4D63%22/%3E%3Cellipse cx=%2228.6%22 cy=%2223.8%22 rx=%221.1%22 ry=%221.9%22 fill=%22%23fff%22 opacity=%22.65%22/%3E%3Ccircle cx=%2290%22 cy=%2226%22 r=%2211%22 fill=%22%23FFC83D%22 opacity=%22.28%22/%3E%3Crect x=%2287.4%22 y=%2215%22 width=%225.2%22 height=%225%22 rx=%221%22 fill=%22%230C1745%22/%3E%3Cellipse cx=%2290%22 cy=%2226%22 rx=%224.6%22 ry=%226.4%22 fill=%22%23FFC83D%22/%3E%3Cellipse cx=%2288.6%22 cy=%2223.8%22 rx=%221.1%22 ry=%221.9%22 fill=%22%23fff%22 opacity=%22.65%22/%3E%3Ccircle cx=%22150%22 cy=%2226%22 r=%2211%22 fill=%22%2343D6CF%22 opacity=%22.28%22/%3E%3Crect x=%22147.4%22 y=%2215%22 width=%225.2%22 height=%225%22 rx=%221%22 fill=%22%230C1745%22/%3E%3Cellipse cx=%22150%22 cy=%2226%22 rx=%224.6%22 ry=%226.4%22 fill=%22%2343D6CF%22/%3E%3Cellipse cx=%22148.6%22 cy=%2223.8%22 rx=%221.1%22 ry=%221.9%22 fill=%22%23fff%22 opacity=%22.65%22/%3E%3Ccircle cx=%22210%22 cy=%2226%22 r=%2211%22 fill=%22%23FFFFFF%22 opacity=%22.28%22/%3E%3Crect x=%22207.4%22 y=%2215%22 width=%225.2%22 height=%225%22 rx=%221%22 fill=%22%230C1745%22/%3E%3Cellipse cx=%22210%22 cy=%2226%22 rx=%224.6%22 ry=%226.4%22 fill=%22%23FFFFFF%22/%3E%3Cellipse cx=%22208.6%22 cy=%2223.8%22 rx=%221.1%22 ry=%221.9%22 fill=%22%23fff%22 opacity=%22.65%22/%3E%3C/svg%3E") repeat-x top left / 240px 44px;
  }
  .snow { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .snow i { position: absolute; left: 0; right: 0; top: -400px; bottom: 0; display: block; }
  .snow .s1 { background: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22260%22 height=%22260%22 viewBox=%220 0 260 260%22%3E%3Ccircle cx=%2220%22 cy=%2230%22 r=%222.4%22 fill=%22%23fff%22 opacity=%220.9%22/%3E%3Ccircle cx=%2285%22 cy=%22120%22 r=%221.8%22 fill=%22%23fff%22 opacity=%220.7%22/%3E%3Ccircle cx=%22150%22 cy=%2260%22 r=%223%22 fill=%22%23fff%22 opacity=%220.85%22/%3E%3Ccircle cx=%22210%22 cy=%22190%22 r=%222%22 fill=%22%23fff%22 opacity=%220.8%22/%3E%3Ccircle cx=%2260%22 cy=%22220%22 r=%222.6%22 fill=%22%23fff%22 opacity=%220.8%22/%3E%3Ccircle cx=%22120%22 cy=%22160%22 r=%221.6%22 fill=%22%23fff%22 opacity=%220.6%22/%3E%3Ccircle cx=%22235%22 cy=%22100%22 r=%222.2%22 fill=%22%23fff%22 opacity=%220.75%22/%3E%3Ccircle cx=%22180%22 cy=%2210%22 r=%221.8%22 fill=%22%23fff%22 opacity=%220.7%22/%3E%3C/svg%3E") repeat; background-size: 260px 260px; animation: fall1 18s linear infinite; }
  .snow .s2 { background: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22380%22 height=%22380%22 viewBox=%220 0 380 380%22%3E%3Ccircle cx=%2240%22 cy=%2270%22 r=%221.5%22 fill=%22%23fff%22 opacity=%220.55%22/%3E%3Ccircle cx=%22130%22 cy=%22200%22 r=%221.2%22 fill=%22%23fff%22 opacity=%220.5%22/%3E%3Ccircle cx=%22250%22 cy=%2230%22 r=%221.6%22 fill=%22%23fff%22 opacity=%220.55%22/%3E%3Ccircle cx=%22330%22 cy=%22160%22 r=%221.3%22 fill=%22%23fff%22 opacity=%220.5%22/%3E%3Ccircle cx=%2290%22 cy=%22320%22 r=%221.5%22 fill=%22%23fff%22 opacity=%220.5%22/%3E%3Ccircle cx=%22210%22 cy=%22280%22 r=%221.2%22 fill=%22%23fff%22 opacity=%220.45%22/%3E%3Ccircle cx=%22360%22 cy=%22330%22 r=%221.4%22 fill=%22%23fff%22 opacity=%220.5%22/%3E%3Ccircle cx=%22300%22 cy=%2290%22 r=%221.1%22 fill=%22%23fff%22 opacity=%220.45%22/%3E%3C/svg%3E") repeat; background-size: 380px 380px; animation: fall2 30s linear infinite; }
  @keyframes fall1 { to { transform: translateY(260px); } }
  @keyframes fall2 { to { transform: translateY(380px); } }

  .wrap { position: relative; z-index: 1; max-width: 620px; margin: 0 auto; padding: 58px 18px 0; }

  header { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 6px 16px; }
  .sky { position: relative; flex: none; width: 170px; margin: -8px 0 0 -10px; }
  .sky-art { display: block; width: 100%; height: auto; overflow: visible; }
  h1 {
    order: 3; flex: 1 1 100%; margin: 4px 0 0; color: #fff;
    font: 700 clamp(2.4rem, 11.5vw, 4rem)/1.02 var(--display); letter-spacing: -0.015em;
    text-shadow: 0 3px 0 rgba(10,20,70,.35);
  }
  h1 .accent { color: var(--gold); }
  .tag {
    flex: none; width: 92px; padding: 30px 6px 12px; text-align: center; color: #fff; margin-top: 6px;
    background: radial-gradient(circle at 50% 17px, #2A479C 0 6px, transparent 6.5px), var(--red);
    clip-path: polygon(0 20px, 20px 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
    transform: rotate(4deg); transform-origin: 50% 0; filter: drop-shadow(0 4px 6px rgba(0,0,0,.3));
  }
  .tag b { display: block; font: 700 2.4rem/1 var(--display); }
  .tag span { display: block; margin-top: 4px; font-size: .78rem; line-height: 1.2; }

  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; margin-top: 26px; }
  .card {
    background: var(--paper); border: 3px solid #fff; border-radius: 24px; overflow: hidden;
    display: flex; flex-direction: column; min-height: 230px;
    box-shadow: 0 10px 26px rgba(8,16,60,.38);
  }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px 12px 14px; border-bottom: 2px solid var(--line); }
  .head .who { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .ico { flex: none; width: 46px; height: 46px; border-radius: 50%; background: #EAF1FF; display: inline-flex; align-items: center; justify-content: center; }
  .ico svg { width: 34px; height: 34px; }
  .head h2 { font: 700 1.4rem/1.1 var(--display); margin: 0; overflow-wrap: anywhere; }
  .upd {
    flex: none; min-height: 40px; padding: 0 18px; border: 0; border-radius: 999px; cursor: pointer;
    font: 600 .92rem var(--body); color: #fff; background: var(--red); box-shadow: 0 2px 0 var(--red-dark);
  }
  .upd:hover { background: var(--red-dark); }
  ul { list-style: none; margin: 0; padding: 0 18px; flex: 1; }
  li { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 0; border-bottom: 2px dashed var(--line); }
  .gift { min-width: 0; overflow-wrap: anywhere; font-weight: 600; }
  .side { flex: none; display: flex; align-items: center; gap: 8px; }
  .linkbtn {
    display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 36px;
    border-radius: 10px; background: var(--pine); color: #fff; text-decoration: none; box-shadow: 0 2px 0 var(--pine-dark);
  }
  .linkbtn:hover { background: var(--pine-dark); }
  .linkbtn svg { width: 18px; height: 18px; }
  .del { min-height: 40px; padding: 0 14px; border-radius: 999px; cursor: pointer; font: 600 .88rem var(--body); border: 1.5px solid #E9C3CA; color: var(--muted); background: transparent; }
  .del.confirm { border-color: var(--red); color: var(--red); }

  .card.editing { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(247,190,62,.35), 0 10px 26px rgba(8,16,60,.38); }
  .card.editing .head { background: var(--gold-soft); border-bottom-color: #F2DDA0; }
  .card.editing .ico { background: #fff; }
  .card.editing li { border-bottom-color: #F2DDA0; }
  .card.editing .upd { background: var(--pine); box-shadow: 0 2px 0 var(--pine-dark); }
  .card.editing .upd:hover { background: var(--pine-dark); }
  form.add { display: none; padding: 14px 18px 18px; background: var(--gold-soft); }
  .card.editing form.add { display: block; }
  input[type=text], input[type=url] {
    width: 100%; min-height: 48px; padding: 10px 14px; font: inherit; font-size: 16px; color: var(--ink);
    background: #fff; border: 1.5px solid #EBDDB0; border-radius: 12px;
  }
  input::placeholder { color: #8A94AD; }
  input:focus { outline: none; border-color: var(--red); }
  form.add input + input { margin-top: 8px; }
  .btn { width: 100%; margin-top: 10px; min-height: 48px; border: 0; border-radius: 999px; cursor: pointer; font: 600 1rem var(--body); color: #fff; background: var(--red); box-shadow: 0 2px 0 var(--red-dark); }
  .btn:hover { background: var(--red-dark); }
  .btn:disabled { opacity: .55; cursor: default; }
  .hint { margin: 8px 0 0; font-size: .88rem; color: var(--red); }
  .hint:empty { display: none; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  .card :focus-visible { outline-color: var(--pine); }

  footer { position: relative; z-index: 1; margin-top: 30px; }
  .scene { display: flex; justify-content: center; padding: 0 8px; margin-bottom: -1px; }
  .scene-art { display: block; width: 100%; max-width: 760px; height: auto; overflow: visible; }
  .ground { background: var(--snow); padding: 4px 18px 26px; text-align: center; }
  .sync { margin: 0; display: inline-flex; align-items: center; gap: 8px; font-size: .84rem; color: var(--muted); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
  .dot.ok { background: var(--pine); }
  .dot.off { background: var(--red); }

  .twinkle { animation: tw 3.2s ease-in-out infinite; }
  @keyframes tw { 0%,100% { opacity: .35; } 50% { opacity: 1; } }

  @media (max-width: 879px) { .card { min-height: 150px; } .sky { width: 190px; } }
  @media (min-width: 880px) {
    .wrap { max-width: 1080px; padding-top: 60px; }
    .sky { width: 300px; margin-left: -20px; }
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .snow i, .twinkle { animation: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tag { transition: transform .4s ease; }
    .tag:hover { transform: rotate(-2deg); }
  }
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs><symbol id="i-tree" viewBox="0 0 48 48"><rect x="21" y="40" width="6" height="6" rx="1" fill="#7A4A22"/>
  <polygon points="24,6 33,22 15,22" fill="#3A9A68"/>
  <polygon points="24,14 36,31 12,31" fill="#2E8559"/>
  <polygon points="24,23 40,41 8,41" fill="#256F4A"/>
  <polygon points="24.00,0.50 25.41,4.06 29.23,4.30 26.28,6.74 27.23,10.45 24.00,8.40 20.77,10.45 21.72,6.74 18.77,4.30 22.59,4.06" fill="#F5B83D" stroke="#E39A1E" stroke-width=".8"/>
  <circle cx="19" cy="34" r="2.3" fill="#E8394D"/><circle cx="29" cy="36" r="2.3" fill="#F5B83D"/>
  <circle cx="24" cy="27" r="2.1" fill="#6FB6F5"/><circle cx="22" cy="19" r="1.6" fill="#E8394D"/></symbol><symbol id="i-star" viewBox="0 0 48 48"><polygon points="24.00,4.00 29.88,16.91 43.97,18.51 33.51,28.09 36.34,41.99 24.00,35.00 11.66,41.99 14.49,28.09 4.03,18.51 18.12,16.91" fill="#F7BE3E" stroke="#E39A1E" stroke-width="1.6" stroke-linejoin="round"/>
  <circle cx="20.5" cy="26" r="1.6" fill="#6B3E0E"/><circle cx="27.5" cy="26" r="1.6" fill="#6B3E0E"/>
  <path d="M21.5 30 Q24 32.8 26.5 30" stroke="#6B3E0E" stroke-width="1.6" fill="none" stroke-linecap="round"/>
  <circle cx="17.5" cy="29.5" r="2.2" fill="#F08A7E" opacity=".55"/><circle cx="30.5" cy="29.5" r="2.2" fill="#F08A7E" opacity=".55"/></symbol><symbol id="i-bauble" viewBox="0 0 48 48"><rect x="21" y="4" width="6" height="6" rx="1.5" fill="#F5B83D"/>
  <path d="M24 3 a3 3 0 0 1 3 3" stroke="#C98A16" stroke-width="1.4" fill="none"/>
  <circle cx="24" cy="28" r="16" fill="#D62F45"/>
  <path d="M9 28 Q16.5 22 24 28 T39 28" stroke="#fff" stroke-width="3.2" fill="none" opacity=".92"/>
  <path d="M10.5 34 Q17 30 24 34 T37.5 34" stroke="#F5B83D" stroke-width="2" fill="none"/>
  <ellipse cx="17.5" cy="20.5" rx="3.6" ry="5.2" transform="rotate(30 17.5 20.5)" fill="#fff" opacity=".35"/></symbol><symbol id="i-gift" viewBox="0 0 48 48"><rect x="8" y="21" width="32" height="22" rx="3" fill="#2E86AB"/>
  <rect x="6" y="16" width="36" height="8" rx="2.5" fill="#1F6F94"/>
  <rect x="21" y="16" width="6" height="27" fill="#F5B83D"/>
  <path d="M24 16 C13 3 8 15 24 16Z" fill="#F7BE3E" stroke="#E39A1E" stroke-width="1"/>
  <path d="M24 16 C35 3 40 15 24 16Z" fill="#F7BE3E" stroke="#E39A1E" stroke-width="1"/>
  <circle cx="14" cy="32" r="1.6" fill="#fff" opacity=".6"/><circle cx="34" cy="36" r="1.6" fill="#fff" opacity=".6"/></symbol><symbol id="i-stocking" viewBox="0 0 48 48"><path d="M15 12 H31 V28 Q31 32 36 34 Q42 36 42 41 Q42 45 37 45 H25 Q15 45 15 36 Z" fill="#D62F45"/>
  <rect x="15" y="19" width="16" height="2.6" fill="#fff" opacity=".85"/><rect x="15" y="24" width="16" height="2.6" fill="#fff" opacity=".85"/>
  <rect x="12" y="5" width="22" height="9" rx="3.5" fill="#fff" stroke="#DDE6F3" stroke-width="1"/>
  <path d="M39 38 Q42 40 41 43" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" opacity=".9"/></symbol><symbol id="i-cane" viewBox="0 0 48 48"><path d="M33 44 V17 C33 9 27.5 6 22 6 C16 6 13 11 13 16" stroke="#fff" stroke-width="7.5" fill="none" stroke-linecap="round"/>
  <path d="M33 44 V17 C33 9 27.5 6 22 6 C16 6 13 11 13 16" stroke="#D62F45" stroke-width="7.5" fill="none" stroke-dasharray="4.2 4.2"/>
  <path d="M33 44 V17 C33 9 27.5 6 22 6 C16 6 13 11 13 16" stroke="#C7C9D6" stroke-width=".8" fill="none" opacity=".0"/></symbol><symbol id="i-bell" viewBox="0 0 48 48"><path d="M24 6 C16 6 13 14 13 22 C13 29 10 31 8 34 H40 C38 31 35 29 35 22 C35 14 32 6 24 6Z" fill="#F7BE3E" stroke="#E39A1E" stroke-width="1.4" stroke-linejoin="round"/>
  <circle cx="24" cy="5.5" r="2.6" fill="#E39A1E"/><circle cx="24" cy="38.5" r="3.8" fill="#C98A16"/>
  <path d="M18 14 Q16 20 17 27" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" opacity=".6"/>
  <path d="M15 36 H33" stroke="#E8394D" stroke-width="0"/></symbol><symbol id="i-snowflake" viewBox="0 0 48 48"><g stroke="#4FA3D9" stroke-width="3" stroke-linecap="round" fill="none"><path d="M5.0 24.0L43.0 24.0"/><path d="M14.5 7.5L33.5 40.5"/><path d="M33.5 7.5L14.5 40.5"/><path d="M35.0 24.0L39.2 19.8"/><path d="M35.0 24.0L39.2 28.2"/><path d="M29.5 33.5L35.3 35.1"/><path d="M29.5 33.5L27.9 39.3"/><path d="M18.5 33.5L20.1 39.3"/><path d="M18.5 33.5L12.7 35.1"/><path d="M13.0 24.0L8.8 28.2"/><path d="M13.0 24.0L8.8 19.8"/><path d="M18.5 14.5L12.7 12.9"/><path d="M18.5 14.5L20.1 8.7"/><path d="M29.5 14.5L27.9 8.7"/><path d="M29.5 14.5L35.3 12.9"/></g><circle cx="24" cy="24" r="3" fill="#fff" stroke="#4FA3D9" stroke-width="1.5"/></symbol><symbol id="i-ginger" viewBox="0 0 48 48"><g stroke="#C98A4B" stroke-width="8" stroke-linecap="round" fill="none">
   <path d="M10 25 H38"/><path d="M20 33 L16.5 42"/><path d="M28 33 L31.5 42"/></g>
  <rect x="16.5" y="17" width="15" height="17" rx="6" fill="#C98A4B"/>
  <circle cx="24" cy="12" r="7.5" fill="#C98A4B"/>
  <circle cx="21.2" cy="11" r="1.2" fill="#5B3416"/><circle cx="26.8" cy="11" r="1.2" fill="#5B3416"/>
  <path d="M21.5 14.5 Q24 17 26.5 14.5" stroke="#5B3416" stroke-width="1.3" fill="none" stroke-linecap="round"/>
  <circle cx="24" cy="22.5" r="1.9" fill="#E8394D"/><circle cx="24" cy="28" r="1.9" fill="#2E8B57"/>
  <g stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M8 25 H9.5"/><path d="M38.5 25 H40"/><path d="M15.5 43 H17.3"/><path d="M30.7 43 H32.5"/></g></symbol></defs></svg>
<div class="snow" aria-hidden="true"><i class="s2"></i><i class="s1"></i></div>
<div class="garland" aria-hidden="true"></div>
<div class="wrap">
  <header>
    <div class="sky" aria-hidden="true"><svg class="sky-art" viewBox="0 0 190 150" aria-hidden="true" focusable="false">
 <defs>
  <radialGradient id="moonG" cx="40%" cy="38%" r="70%"><stop offset="0" stop-color="#FFFDF0"/><stop offset=".7" stop-color="#FFF0B8"/><stop offset="1" stop-color="#F6DC84"/></radialGradient>
  <radialGradient id="glowG" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#FFF3C2" stop-opacity=".55"/><stop offset="1" stop-color="#FFF3C2" stop-opacity="0"/></radialGradient>
 </defs>
 <circle cx="112" cy="78" r="74" fill="url(#glowG)"/>
 <circle cx="112" cy="78" r="50" fill="url(#moonG)"/>
 <circle cx="96" cy="94" r="7" fill="#F0D577" opacity=".45"/><circle cx="130" cy="64" r="5" fill="#F0D577" opacity=".4"/><circle cx="124" cy="104" r="4" fill="#F0D577" opacity=".35"/>
 <g transform="translate(34 20) rotate(-7 55 25) scale(.98)">
  <path d="M34 28 Q55 22 66 30" stroke="#F5B83D" stroke-width="1.3" fill="none"/>
  <g stroke="#6B4423" stroke-width="2.4" stroke-linecap="round"><path d="M19 34 L14 42"/><path d="M24 35 L24 44"/><path d="M31 35 L36 41"/><path d="M35 33 L41 38"/></g>
  <ellipse cx="26" cy="30" rx="10.5" ry="5.8" fill="#8B5A33"/><circle cx="15.5" cy="27.5" r="2.4" fill="#8B5A33"/>
  <path d="M33 27 L38 20" stroke="#8B5A33" stroke-width="5" stroke-linecap="round"/>
  <circle cx="39.5" cy="19.5" r="4.6" fill="#8B5A33"/><circle cx="43.4" cy="21" r="2" fill="#E8394D"/><circle cx="40" cy="18" r="0.9" fill="#2a1608"/>
  <path d="M37 16 L35 9 M35.2 12 L31 10 M40 15.5 L42.5 8.5 M42 11.5 L46 9.5" stroke="#6B4423" stroke-width="1.7" stroke-linecap="round" fill="none"/>
  <path d="M60 42 H100 Q109 42 109 33" stroke="#F5B83D" stroke-width="2.4" fill="none" stroke-linecap="round"/>
