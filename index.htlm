="#6FB6F5"/><circle cx="611.9" cy="155.0" r="0.5" fill="#fff" opacity=".6"/><circle cx="604.0" cy="132.1" r="1.8" fill="#E8394D"/><circle cx="603.5" cy="131.5" r="0.5" fill="#fff" opacity=".6"/><circle cx="599.0" cy="136.3" r="1.8" fill="#F7BE3E"/><circle cx="598.5" cy="135.7" r="0.5" fill="#fff" opacity=".6"/><circle cx="608.2" cy="123.7" r="1.8" fill="#F7BE3E"/><circle cx="607.7" cy="123.1" r="0.5" fill="#fff" opacity=".6"/><circle cx="601.5" cy="122.0" r="1.8" fill="#E8394D"/><circle cx="601.0" cy="121.4" r="0.5" fill="#fff" opacity=".6"/><polygon points="604.00,109.40 605.09,112.10 607.99,112.30 605.76,114.17 606.47,117.00 604.00,115.45 601.53,117.00 602.24,114.17 600.01,112.30 602.91,112.10" fill="#F7BE3E" stroke="#E39A1E" stroke-width="0.4" stroke-linejoin="round"/></g><g><rect x="228" y="108" width="46" height="38" rx="3" fill="#D62F45"/><rect x="226" y="108" width="50" height="9.1" rx="2.5" fill="#B8243A"/><rect x="247.1" y="108" width="7.8" height="38" fill="#F7BE3E"/><path d="M251.0 108.0 C235.4 91.4 230.8 108.9 251.0 108.0Z" fill="#F7BE3E" stroke="#00000022" stroke-width=".8"/><path d="M251.0 108.0 C266.6 91.4 271.2 108.9 251.0 108.0Z" fill="#F7BE3E" stroke="#00000022" stroke-width=".8"/><circle cx="236.3" cy="135.4" r="2" fill="#fff" opacity=".55"/><circle cx="246.4" cy="127.0" r="2" fill="#fff" opacity=".55"/><circle cx="256.5" cy="135.4" r="2" fill="#fff" opacity=".55"/><circle cx="266.6" cy="127.0" r="2" fill="#fff" opacity=".55"/></g><g><rect x="270" y="90" width="58" height="54" rx="3" fill="#2E86AB"/><rect x="268" y="90" width="62" height="13.0" rx="2.5" fill="#1F6F94"/><rect x="294.1" y="90" width="9.9" height="54" fill="#F7BE3E"/><path d="M299.0 90.0 C279.3 69.1 273.5 91.2 299.0 90.0Z" fill="#F7BE3E" stroke="#00000022" stroke-width=".8"/><path d="M299.0 90.0 C318.7 69.1 324.5 91.2 299.0 90.0Z" fill="#F7BE3E" stroke="#00000022" stroke-width=".8"/></g><g><rect x="326" y="114" width="44" height="32" rx="3" fill="#3A9A68"/><rect x="324" y="114" width="48" height="8.0" rx="2.5" fill="#2E8559"/><rect x="344.3" y="114" width="7.5" height="32" fill="#fff"/><path d="M348.0 114.0 C333.0 98.2 328.6 114.9 348.0 114.0Z" fill="#fff" stroke="#00000022" stroke-width=".8"/><path d="M348.0 114.0 C363.0 98.2 367.4 114.9 348.0 114.0Z" fill="#fff" stroke="#00000022" stroke-width=".8"/></g><g><rect x="366" y="100" width="52" height="46" rx="3" fill="#8E5BC0"/><rect x="364" y="100" width="56" height="11.0" rx="2.5" fill="#7747A8"/><rect x="387.6" y="100" width="8.8" height="46" fill="#F7BE3E"/><path d="M392.0 100.0 C374.3 81.3 369.1 101.0 392.0 100.0Z" fill="#F7BE3E" stroke="#00000022" stroke-width=".8"/><path d="M392.0 100.0 C409.7 81.3 414.9 101.0 392.0 100.0Z" fill="#F7BE3E" stroke="#00000022" stroke-width=".8"/><circle cx="375.4" cy="133.1" r="2" fill="#fff" opacity=".55"/><circle cx="386.8" cy="123.0" r="2" fill="#fff" opacity=".55"/><circle cx="398.2" cy="133.1" r="2" fill="#fff" opacity=".55"/><circle cx="409.7" cy="123.0" r="2" fill="#fff" opacity=".55"/></g><g><rect x="250" y="86" width="30" height="22" rx="3" fill="#F7BE3E"/><rect x="248" y="86" width="34" height="8.0" rx="2.5" fill="#E39A1E"/><rect x="262.4" y="86" width="5.1" height="22" fill="#D62F45"/><path d="M265.0 86.0 C254.8 75.2 251.8 86.6 265.0 86.0Z" fill="#D62F45" stroke="#00000022" stroke-width=".8"/><path d="M265.0 86.0 C275.2 75.2 278.2 86.6 265.0 86.0Z" fill="#D62F45" stroke="#00000022" stroke-width=".8"/></g><g transform="translate(298 84)"><path d="M-9 4 L-16 8 L-10 9Z" fill="#7A4A22"/><ellipse cx="0" cy="0" rx="9" ry="7.5" fill="#8B5A33"/><ellipse cx="3.5" cy="2.2" rx="5.5" ry="5" fill="#E8643A"/><circle cx="5.5" cy="-5.5" r="5" fill="#8B5A33"/><circle cx="8" cy="-4" r="2.8" fill="#E8643A"/><path d="M10 -6 L14 -5 L10 -4Z" fill="#F5B83D"/><circle cx="6.8" cy="-6.6" r="1" fill="#1a1a1a"/><path d="M-2 7.5 V11 M3 7.5 V11" stroke="#6B4423" stroke-width="1.3" stroke-linecap="round"/></g><path  d="M190 54 Q190 60 196 60 Q190 60 190 66 Q190 60 184 60 Q190 60 190 54Z" fill="#FFE9A3"/><path  d="M450 45 Q450 52 457 52 Q450 52 450 59 Q450 52 443 52 Q450 52 450 45Z" fill="#fff"/><path  d="M330 29 Q330 34 335 34 Q330 34 330 39 Q330 34 325 34 Q330 34 330 29Z" fill="#FFE9A3"/><path  d="M70 65 Q70 70 75 70 Q70 70 70 75 Q70 70 65 70 Q70 70 70 65Z" fill="#fff"/><path  d="M585 71 Q585 76 590 76 Q585 76 585 81 Q585 76 580 76 Q585 76 585 71Z" fill="#FFE9A3"/><path  d="M230 20 Q230 24 234 24 Q230 24 230 28 Q230 24 226 24 Q230 24 230 20Z" fill="#fff"/></svg></div>
  <div class="ground"><p class="sync"><span class="dot" id="dot"></span><span id="syncText">Łączę z listą…</span></p></div>
</footer>

<script>
(function () {
  // >>> Adres wdrożenia z Apps Script (kończy się na /exec) <<<
  var API = 'https://script.google.com/macros/s/AKfycbwFtFDP4NiNgczQdENDltwLqUF94MiOvQ-dSZBwSN9TGBGOCGi7Jb1gp2bXac4GKlSM5w/exec';

  // Prostokąty istnieją od razu. Jeśli serwer zwróci inną listę osób (Code.gs), strona ją przejmie.
  var ICONS = ["tree", "star", "bauble", "stocking", "gift", "cane", "bell", "snowflake", "ginger"];
  var DEFAULT_PEOPLE = ['Tata', 'Mama', 'Ola', 'Tomek Piecha', 'Asia', 'Piotrek', 'Kacper', 'Iza', 'Tomek Bomek'];

  var $ = function (id) { return document.getElementById(id); };
  function el(tag, cls, text) {
    var n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text != null) n.textContent = text;
    return n;
  }
  function errText(e) { return (e && e.message ? e.message : 'Coś poszło nie tak.').replace(/^Error:\s*/, ''); }
  function host(url) { try { return new URL(url).hostname.replace(/^www\./, ''); } catch (e) { return 'link'; } }

  var people = DEFAULT_PEOPLE.slice(), items = [], editing = '', builtKey = '', lastItems = '', busy = false;
  var ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>';

  /* Odliczanie do Wigilii */
  (function () {
    var now = new Date(), y = now.getFullYear();
    var today = new Date(y, now.getMonth(), now.getDate());
    var target = new Date(y, 11, 24);
    if (today > target) target = new Date(y + 1, 11, 24);
    var d = Math.round((target - today) / 86400000);
    if (d === 0) { $('days').textContent = '🎄'; $('daysLabel').textContent = 'Dziś Wigilia!'; return; }
    $('days').textContent = d;
    $('daysLabel').textContent = (d === 1 ? 'dzień' : 'dni') + ' do Wigilii';
  })();

  /* Komunikacja z serwerem (bez ciasteczek, więc liczba zalogowanych kont Google nie ma znaczenia) */
  function api(params) {
    if (API.indexOf('https://') !== 0) return Promise.reject(new Error('Brak adresu serwera. Uzupełnij zmienną API w pliku index.html.'));
    var q = new URLSearchParams(params);
    q.set('_', Date.now());
    return fetch(API + '?' + q.toString(), { method: 'GET', credentials: 'omit' })
      .then(function (r) { return r.json(); })
      .then(function (d) { if (d.error) throw new Error(d.error); return d; });
  }
  function setSync(ok, text) {
    $('dot').className = 'dot ' + (ok ? 'ok' : 'off');
    $('syncText').textContent = text;
  }

  function apply(d) {
    var np = (d.people && d.people.length) ? d.people : people;
    var key = np.join('|');
    var rebuilt = false;
    if (key !== builtKey) {
      people = np; builtKey = key;
      if (editing && people.indexOf(editing) < 0) editing = '';
      buildAll(); rebuilt = true;
    }
    var json = JSON.stringify(d.items || []);
    if (rebuilt || json !== lastItems) { lastItems = json; items = d.items || []; fillLists(); }
  }

  function refresh() {
    if (busy) return;
    api({ action: 'list' }).then(function (d) {
      if (busy) return;
      apply(d); setSync(true, 'Zsynchronizowano');
    }).catch(function (e) {
      setSync(false, /^Brak adresu/.test(errText(e)) ? errText(e) : 'Brak połączenia. Próbuję ponownie…');
    });
  }

  /* Prostokąty */
  function cards() { return Array.prototype.slice.call($('grid').children); }

  function buildAll() {
    var grid = $('grid');
    grid.textContent = '';
    people.forEach(function (n, i) { grid.appendChild(card(n, i)); });
    syncEditUI();
  }

  function card(name, idx) {
    var c = el('section', 'card');
    c.setAttribute('data-who', name);
    var head = el('div', 'head');
    var who = el('div', 'who');
    var ico = el('span', 'ico');
    ico.innerHTML = '<svg viewBox="0 0 48 48" aria-hidden="true" focusable="false"><use href="#i-' + ICONS[idx % ICONS.length] + '"/></svg>';
    who.appendChild(ico);
    who.appendChild(el('h2', null, name));
    head.appendChild(who);
    var btn = el('button', 'upd', 'Edytuj'); btn.type = 'button';
    btn.addEventListener('click', function () { toggleEdit(name); });
    head.appendChild(btn);
    c.appendChild(head);
    c.appendChild(el('ul'));
    c.appendChild(form(name));
    return c;
  }

  function syncEditUI() {
    cards().forEach(function (c) {
      var on = c.getAttribute('data-who') === editing;
      c.classList.toggle('editing', on);
      var b = c.querySelector('.upd');
      b.textContent = on ? 'Gotowe' : 'Edytuj';
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  function toggleEdit(name) {
    editing = (editing === name) ? '' : name;
    syncEditUI();
    fillLists();
    if (editing) {
      var inp = document.querySelector('.card.editing input');
      if (inp) inp.focus();
    }
  }

  function form(name) {
    var f = el('form', 'add'); f.setAttribute('autocomplete', 'off'); f.noValidate = true;
    var g = el('input'); g.type = 'text'; g.maxLength = 120; g.placeholder = 'Pomysł na prezent'; g.setAttribute('aria-label', 'Pomysł na prezent dla: ' + name);
    var l = el('input'); l.type = 'url'; l.maxLength = 300; l.placeholder = 'Link (opcjonalnie)'; l.setAttribute('aria-label', 'Link do sklepu, opcjonalnie'); l.setAttribute('inputmode', 'url');
    var b = el('button', 'btn', 'Dodaj'); b.type = 'submit';
    var h = el('p', 'hint'); h.setAttribute('role', 'status');
    f.appendChild(g); f.appendChild(l); f.appendChild(b); f.appendChild(h);
    f.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var gift = g.value.trim();
      if (!gift) { h.textContent = 'Wpisz pomysł na prezent.'; g.focus(); return; }
      h.textContent = ''; b.disabled = true; b.textContent = 'Dodaję…';
      busy = true;
      api({ action: 'add', who: name, gift: gift, link: l.value.trim() }).then(function (d) {
        busy = false; g.value = ''; l.value = ''; apply(d); setSync(true, 'Zsynchronizowano'); g.focus();
      }).catch(function (e) {
        busy = false; h.textContent = errText(e);
      }).then(function () { b.disabled = false; b.textContent = 'Dodaj'; });
    });
    return f;
  }

  function fillLists() {
    cards().forEach(function (c) {
      var name = c.getAttribute('data-who');
      var edit = name === editing;
      var ul = c.querySelector('ul');
      ul.textContent = '';
      items.filter(function (i) { return i.who === name; }).forEach(function (it) {
        ul.appendChild(row(it, edit, name));
      });
    });
  }

  function row(it, edit, name) {
    var li = el('li');
    li.appendChild(el('div', 'gift', it.gift));
    var side = el('div', 'side');
    if (/^https?:\/\//i.test(it.link)) {
      var a = el('a', 'linkbtn');
      a.innerHTML = ARROW;
      a.href = it.link; a.target = '_blank'; a.rel = 'noopener noreferrer';
      a.title = host(it.link); a.setAttribute('aria-label', 'Otwórz link: ' + host(it.link));
      side.appendChild(a);
    }
    if (edit) {
      var del = el('button', 'del', 'Usuń'); del.type = 'button';
      var armed = false, t;
      del.addEventListener('click', function () {
        if (!armed) {
          armed = true; del.textContent = 'Na pewno?'; del.classList.add('confirm');
          t = setTimeout(function () { armed = false; del.textContent = 'Usuń'; del.classList.remove('confirm'); }, 3000);
          return;
        }
        clearTimeout(t);
        if (busy) return;
        busy = true;
        api({ action: 'delete', who: name, id: it.id }).then(function (d) {
          busy = false; apply(d); setSync(true, 'Zsynchronizowano');
        }).catch(function (e) { busy = false; setSync(false, errText(e)); });
      });
      side.appendChild(del);
    }
    if (side.children.length) li.appendChild(side);
    return li;
  }

  builtKey = people.join('|');
  buildAll();
  refresh();
  setInterval(function () { if (!document.hidden) refresh(); }, 10000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
})();
</script>
</body>
</html>
